generator client {
  provider   = "prisma-client-js"
  engineType = "js"
}

datasource db {
  provider = "mysql"
}

model User {
  id                         String                    @id @default(cuid())
  name                       String?
  email                      String                    @unique
  passwordHash               String?
  githubId                   String?                   @unique
  avatarUrl                  String?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  emailVerifiedAt            DateTime?
  monthlyWorkloadTargetHours Float?
  themePreference            String                    @default("light")
  locale                     String                    @default("en")
  emailNotificationsEnabled  Boolean                   @default(true)
  onboardingStatus           String                    @default("NOT_STARTED")
  onboardingVersion          Int                       @default(0)
  onboardingUpdatedAt        DateTime?
  emailQueues                EmailQueue[]
  memberships                Member[]
  notificationActed          Notification[]            @relation("NotificationActor")
  notifications              Notification[]
  sessions                   Session[]
  assignedTasks              Task[]                    @relation("TaskAssignee")
  taskComments               TaskComment[]
  taskCommentMentions        TaskCommentMention[]
  conversationParticipants   ConversationParticipant[]
  conversationMessages       ConversationMessage[]     @relation("ConversationMessageSender")
  projectDocs                ProjectDoc[]
  projectDocSections         ProjectDocSection[]
  taskMediaUploads           TaskMedia[]               @relation("TaskMediaUploader")
  workspaceGroupMemberships  WorkspaceGroupMember[]
  ownedWorkspaces            Workspace[]               @relation("WorkspaceOwner")
  uiPreferences              UiPreference[]
  emailVerification          EmailVerificationToken?
  passwordReset              PasswordResetToken?
  telegramConnection         TelegramConnection?
  telegramLinkTokens         TelegramLinkToken[]
  agentApiKeys               AgentApiKey[]
  agentProposals             AgentProposal[]
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Session_userId_fkey")
}

model Workspace {
  id                 String              @id @default(cuid())
  name               String
  inviteCode         String              @unique
  imageUrl           String?             @db.Text
  ownerId            String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  members            Member[]
  notifications      Notification[]
  projects           Project[]
  tasks              Task[]
  taskComments       TaskComment[]
  conversations      Conversation[]
  projectDocs        ProjectDoc[]
  projectDocSections ProjectDocSection[]
  taskMedia          TaskMedia[]
  groups             WorkspaceGroup[]
  owner              User                @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  uiPreferences      UiPreference[]
  agentProposals     AgentProposal[]

  @@index([ownerId], map: "Workspace_ownerId_fkey")
}

model AgentApiKey {
  id          String    @id @default(cuid())
  userId      String
  name        String
  keyPrefix   String
  tokenHash   String    @unique @db.VarChar(64)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposals AgentProposal[]

  @@index([userId])
  @@index([revokedAt])
}

model AgentProposal {
  id          String              @id @default(cuid())
  userId      String
  apiKeyId    String?
  workspaceId String
  title       String
  summary     String?             @db.Text
  operations  Json
  status      AgentProposalStatus @default(PENDING)
  result      Json?
  error       String?             @db.Text
  reviewedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKey    AgentApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([workspaceId])
  @@index([apiKeyId])
  @@index([createdAt])
}

model UiPreference {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  key         String
  value       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId, key])
  @@index([userId])
  @@index([workspaceId])
}

model Member {
  id          String     @id @default(cuid())
  role        MemberRole @default(MEMBER)
  userId      String
  workspaceId String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
}

model WorkspaceGroup {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  color       String?
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace    Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members      WorkspaceGroupMember[]
  tasks        Task[]
  conversation Conversation?

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model WorkspaceGroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  createdAt DateTime @default(now())

  group WorkspaceGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId])
}

model Project {
  id            String              @id @default(cuid())
  name          String
  imageUrl      String?             @db.Text
  workspaceId   String
  parentId      String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  notifications Notification[]
  docs          ProjectDoc[]
  docSections   ProjectDocSection[]
  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks         Task[]
  parent        Project?            @relation("ProjectHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children      Project[]           @relation("ProjectHierarchy")

  @@index([workspaceId])
  @@index([parentId])
}

model Task {
  id              String          @id @default(cuid())
  name            String
  status          TaskStatus      @default(BACKLOG)
  priority        TaskPriority    @default(MEDIUM)
  dueDate         DateTime?
  startedAt       DateTime?
  estimatedHours  Float?
  actualHours     Float?
  description     String?
  position        Int             @default(1000)
  workspaceId     String
  projectId       String
  parentId        String?
  assigneeId      String?
  assigneeGroupId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  notifications   Notification[]
  comments        TaskComment[]
  assignee        User?           @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  assigneeGroup   WorkspaceGroup? @relation(fields: [assigneeGroupId], references: [id], onDelete: SetNull)
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent          Task?           @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children        Task[]          @relation("TaskHierarchy")
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  media           TaskMedia[]

  @@index([workspaceId])
  @@index([projectId])
  @@index([parentId])
  @@index([assigneeId])
  @@index([assigneeGroupId])
  @@index([status])
}

model ProjectDoc {
  id          String   @id @default(cuid())
  workspaceId String
  projectId   String
  authorId    String
  sectionId   String?
  title       String
  body        String   @db.LongText
  isLocked    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  section   ProjectDocSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([projectId])
  @@index([authorId])
  @@index([sectionId])
  @@index([updatedAt])
}

model ProjectDocSection {
  id          String   @id @default(cuid())
  workspaceId String
  projectId   String
  authorId    String
  title       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  docs      ProjectDoc[]

  @@index([workspaceId])
  @@index([projectId])
  @@index([authorId])
  @@index([updatedAt])
}

model TaskComment {
  id          String   @id @default(cuid())
  taskId      String
  workspaceId String
  authorId    String
  body        String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task      Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mentions  TaskCommentMention[]

  @@index([taskId])
  @@index([workspaceId])
  @@index([authorId])
  @@index([createdAt])
}

model TaskCommentMention {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId])
}

model Conversation {
  id          String           @id @default(cuid())
  workspaceId String
  type        ConversationType @default(DIRECT)
  name        String?
  channelKey  String?
  groupId     String?          @unique
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace    Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     ConversationMessage[]
  group        WorkspaceGroup?           @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, channelKey])
  @@index([workspaceId])
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model ConversationMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String   @db.Text
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("ConversationMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model TelegramConnection {
  id             String   @id @default(cuid())
  userId         String   @unique
  telegramUserId String   @unique
  telegramChatId String   @unique
  username       String?
  firstName      String?
  lastName       String?
  linkedAt       DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TelegramLinkToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model TelegramUpdate {
  updateId  String   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  taskId      String?
  projectId   String?
  actorId     String?
  type        String
  message     String?
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  actor       User?     @relation("NotificationActor", fields: [actorId], references: [id])
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
  @@index([isRead])
  @@index([actorId], map: "Notification_actorId_fkey")
  @@index([projectId], map: "Notification_projectId_fkey")
  @@index([taskId], map: "Notification_taskId_fkey")
}

model EmailQueue {
  id        String           @id @default(cuid())
  userId    String?
  toEmail   String
  subject   String
  htmlBody  String           @db.LongText
  textBody  String           @db.LongText
  status    EmailQueueStatus @default(PENDING)
  attempts  Int              @default(0)
  lastError String?          @db.Text
  sentAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User?            @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@index([userId], map: "EmailQueue_userId_fkey")
}

model TaskMedia {
  id           String             @id @default(cuid())
  taskId       String?
  workspaceId  String
  uploadedById String?
  storageKey   String?            @unique
  path         String?
  mime         String?
  originalName String?
  size         Int                @default(0)
  resolution   Int?
  createdAt    DateTime           @default(now())
  task         Task?              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy   User?              @relation("TaskMediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  variants     TaskMediaVariant[]

  @@index([taskId])
  @@index([workspaceId])
  @@index([uploadedById])
  @@index([taskId, createdAt])
}

model TaskMediaVariant {
  id          String   @id @default(cuid())
  taskMediaId String
  storageKey  String?  @unique
  path        String?
  mime        String?
  size        Int      @default(0)
  resolution  Int?
  createdAt   DateTime @default(now())

  taskMedia TaskMedia @relation(fields: [taskMediaId], references: [id], onDelete: Cascade)

  @@index([taskMediaId])
}

enum MemberRole {
  ADMIN
  MEMBER
}

enum ConversationType {
  DIRECT
  WORKSPACE
  GROUP
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  VERY_LOW
  LOW
  MEDIUM
  HIGH
  REAL_TIME
}

enum EmailQueueStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

enum AgentProposalStatus {
  PENDING
  APPROVED
  REJECTED
  FAILED
}
