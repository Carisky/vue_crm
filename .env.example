DATABASE_CONNECTION_LIMIT=30
# Optional database backup settings
DB_BACKUP_DIR=
DB_DOCKER_CONTAINER=vue-crm-dev-db
DB_DOCKER_HOST=127.0.0.1
DB_DOCKER_PORT=3306
MARIADB_DUMP_BIN=
MARIADB_BIN=
STORAGE_ROOT=/var/lib/vue-crm/storage
STORAGE_MAX_FILE_SIZE_MB=50
STORAGE_MAX_FILES_PER_UPLOAD=10
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_AUTO_SETUP_WEBHOOK=false

# Mattermost CRM integration (server-only)
# Private Mattermost API; never point this at the public 8065 gateway.
MATTERMOST_INTERNAL_URL=http://127.0.0.1:8066
# Leave empty when MATTERMOST_RUNTIME_ENV_FILE contains MATTERMOST_ADMIN_TOKEN.
MATTERMOST_ADMIN_TOKEN=
# Same 32+ byte secret as MATTERMOST_SHARED_SECRET in the Mattermost stack.
MATTERMOST_PLUGIN_SECRET=
MATTERMOST_SYNC_ENABLED=false
MATTERMOST_PLUGIN_ID=com.tsl-silesia.crm-sync
MATTERMOST_CALLBACK_URL=http://127.0.0.1:3000/api/integrations/mattermost/events
# Absolute, root-owned mode-0600 file generated during bootstrap.
MATTERMOST_RUNTIME_ENV_FILE=/var/lib/vue-crm/secrets/mattermost.runtime.env
MATTERMOST_COMPOSE_DIR=/opt/mattermost
MATTERMOST_IMPORT_DIR=/opt/mattermost/imports
MATTERMOST_BOOTSTRAP_USERNAME=crm-bootstrap-admin
MATTERMOST_BOOTSTRAP_EMAIL=crm-bootstrap@localhost.invalid

# Destructive acceptance tests are disabled by default. Use only with a
# disposable database whose name contains "mattermost_e2e" and a fixture stack.
MATTERMOST_E2E=false
MATTERMOST_E2E_DATABASE_URL=
MATTERMOST_E2E_COMPOSE_DIR=
MATTERMOST_E2E_INTERNAL_URL=http://127.0.0.1:18066
MATTERMOST_E2E_PUBLIC_URL=http://127.0.0.1:18065
MATTERMOST_E2E_RUNNER=
