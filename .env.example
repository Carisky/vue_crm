DATABASE_CONNECTION_LIMIT=30
# Optional database backup settings
DB_BACKUP_DIR=
DB_DOCKER_CONTAINER=vue-crm-dev-db
DB_DOCKER_HOST=127.0.0.1
DB_DOCKER_PORT=3306
MARIADB_DUMP_BIN=
MARIADB_BIN=
STORAGE_ROOT=/var/lib/vue-crm/storage
STORAGE_MAX_FILE_SIZE_MB=50
STORAGE_MAX_FILES_PER_UPLOAD=10
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_AUTO_SETUP_WEBHOOK=false

# Mattermost CRM integration (server-only)
MATTERMOST_INTERNAL_URL=http://127.0.0.1:8066
MATTERMOST_ADMIN_TOKEN=
MATTERMOST_PLUGIN_SECRET=
MATTERMOST_SYNC_ENABLED=false
MATTERMOST_PLUGIN_ID=com.tsl-silesia.crm-sync
MATTERMOST_CALLBACK_URL=http://127.0.0.1:3000/api/integrations/mattermost/events
MATTERMOST_RUNTIME_ENV_FILE=
